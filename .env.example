# Opcional. Usado só para o preço intradiário — os fundamentos vêm de Investidor10,
# StatusInvest e Fundamentus. Os módulos de fundamentos da brapi são do plano Pro
# (R$ 139,99/mês) e o radar não depende deles. Crie em https://brapi.dev/dashboard
BRAPI_TOKEN=

# Só usada com a flag --ai (CLI) ou o checkbox de IA (app).
ANTHROPIC_API_KEY=

# CDI anualizado em pontos percentuais (ex.: 13.9), usado só como fallback: a série do
# Banco Central (API pública, sem token) é a fonte primária.
RADAR_CDI_ANUAL=

# Caminho do banco de cache (default: ./radar-dividendos.sqlite)
RADAR_CACHE_PATH=
